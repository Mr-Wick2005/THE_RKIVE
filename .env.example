# Supabase Configuration
# Obtain these values from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only privileged key (DO NOT expose in client-side code).
# Use the current `sb_secret_...` key, or the legacy service-role JWT if your
# Supabase project still provides one. Never put a publishable key here.
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-to-Server PDF Worker Secret (Used by Supabase pg_cron + pg_net and autonomous continuation)
# Must match between Vercel Environment Variables and Supabase pg_cron schedule
PDF_WORKER_SECRET=your-secure-random-worker-secret

# Cloudflare R2 Public Serving URL (Phase 4; enables $0 egress CDN serving)
# Obtain this from Cloudflare R2 -> magazine-files-public -> Settings -> Public Access -> R2.dev or Custom Domain
# Example: https://pub-xxxxxxxxxxxxxxxx.r2.dev or https://media.yourdomain.edu
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-r2-public-domain.r2.dev

# Cloudflare R2 Server-Side Configuration (Phase 5; DO NOT expose to client-side code)
# Obtain from Cloudflare Dashboard -> R2 -> Overview -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BUCKET_NAME=magazine-files-public
R2_PRIVATE_BUCKET_NAME=magazine-files-private

